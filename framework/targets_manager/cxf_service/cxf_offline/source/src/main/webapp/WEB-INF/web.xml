<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <filter>
        <filter-name>MockAuthFilter</filter-name>
        <filter-class>fuzz.cxf.MockAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>MockAuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!--
        IMPORTANT: do NOT configure Spring's ContextLoaderListener here.
        CXFServlet instantiates its OWN Spring ApplicationContext from
        /WEB-INF/cxf-servlet.xml on init.  If we also declare a
        ContextLoaderListener with contextConfigLocation=cxf-servlet.xml,
        the <jaxrs:server> bean ("oauth2") is created TWICE — once in the
        root context (succeeds, registers /oauth2 on the CXF bus) and
        once in the servlet's child context (fails with
        ServiceConstructionException because /oauth2 is already
        published).  Every subsequent HTTP request re-triggers the
        failing child-context init and returns HTTP 500.

        Pattern: one webapp, one Spring config, one owner — the servlet.
    -->
    <servlet>
        <servlet-name>CXFServlet</servlet-name>
        <servlet-class>org.apache.cxf.transport.servlet.CXFServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>CXFServlet</servlet-name>
        <url-pattern>/services/*</url-pattern>
    </servlet-mapping>
</web-app>